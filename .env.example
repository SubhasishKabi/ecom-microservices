# ============================================================
# E-Commerce Microservices Environment Configuration Template
# ============================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Message Brokers
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis (gateway rate limiter)
REDIS_HOST=localhost
REDIS_PORT=6379

# Service Discovery & Config
EUREKA_SERVER_URL=http://localhost:8761/eureka/
CONFIG_SERVER_URL=http://localhost:8888

# JWT Security
# 256-bit base64 / hex key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Client Configuration (Vite frontend - must be prefixed with VITE_ to be exposed to the browser)
VITE_API_BASE_URL=http://localhost:8080

# Optional - observability / admin tooling (sensible defaults baked into docker-compose.yml)
# ZIPKIN_URL=http://zipkin:9411
# PGADMIN_DEFAULT_EMAIL=pgadmin4@pgadmin.org
# PGADMIN_DEFAULT_PASSWORD=admin
